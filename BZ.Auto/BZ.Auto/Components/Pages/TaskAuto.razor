            }
        };
        RoundRunning = RoundMax;
        try
        {
            ValueAutoCompleteTableName = tableName;
            var tableN = await SQLiteContext.ListTableName();
            ItemsTableName = filteredItemsTableName = tableN;
            await OnLoadAsync();
        }
        catch
        {

        }
    }

    void Remove(ImageStepModel item)
    {
        Items.Remove(item);
    }

    void AddRow()
    {
        Items.Add(new ImageStepModel
        {
            BaseImage = ImageCapture.Default,
            CurrentFromScreenSmallToCompare = ImageCapture.Default,
            TopLeftX = 10,
            TopLeftY = 20,
            BotRightX = 100,
            BotRightY = 200,
            Interval = 5,
            AfterClick = 0,
            ReCheckInterval = 2,
            NextStepFound = 0,
            NextStepNotFound = 0,
            Active = true,
            FourceStopLoop = false
        });
    }


    public int intervalLoop = 300;
    public int processRecheckIfNotFound = 0;
    public int processRecheckIfNotFoundMax = 3;
    bool isStartLoop = false;
    CancellationTokenSource _cts;
    async Task OnStartAutoAsync()
    {
        await JS.InvokeVoidAsync("unlockAudio");


        int RandomIntBetween = 0;
        int timeCount = 0;
        processRecheckIfNotFound = 0;
        Console.ForegroundColor = ConsoleColor.Green;
        Console.WriteLine("Start");
        Console.ResetColor();
        processNumber = 0;
        RoundRunning = RoundMax;
        isStartLoop = true;
        DateTime startTime = DateTime.Now;
        _cts = new CancellationTokenSource();

        List<string> messages = new List<string>();
        while (!_cts.Token.IsCancellationRequested && isStartLoop)
        {
            try
            {
                await InvokeAsync(StateHasChanged);

                Console.WriteLine();
                Console.WriteLine("DateTime:" + DateTime.Now);
                Console.ForegroundColor = ConsoleColor.Cyan;
                Console.WriteLine($"Process :{processNumber} | Round {RoundRunning} / {RoundMax}");
                Console.ResetColor();
                //ปิดเครื่องนอน วอจบแล้ว
                if (DateTime.Now.Hour > 22)
                {
                    //var psi = new ProcessStartInfo("shutdown", "/s /t 0");
                    //psi.CreateNoWindow = true;
                    //psi.UseShellExecute = false;
                    //Process.Start(psi);
                    // await OnStopAutoAsync();
                }


                if (Items[processNumber].FourceStopLoop == true)
                {
                    RoundRunning = 0;
                    processRecheckIfNotFound = 0;
                    processNumber = 0;
                    await OnStopAutoAsync();
                    await JS.InvokeVoidAsync("playJingle", "sounds/danger-alert.mp3", _currentVolumn.Value);
                    return;
                }

                // Console.WriteLine("Check RoundCount");
                if (RoundRunning <= 0)
                {
                    Console.ForegroundColor = ConsoleColor.Yellow;
                    Console.WriteLine($"Process {processNumber} : RoundCount <= 0");
                    Console.ResetColor();
                    await OnStopAutoAsync();
                    return;
                }

                // Console.WriteLine("Check processNumber");
                if (processNumber == Items.Count())
                {
                    Console.ForegroundColor = ConsoleColor.DarkYellow;
                    Console.WriteLine($"Process {processNumber} : processNumber >= Items.Count()");
                    Console.ResetColor();
                    processRecheckIfNotFound = 0;
                    processNumber = 0;
                    // // RoundRunning--;
                    RandomIntBetween = 0;
                    timeCount = 0;
                    continue;
                }

                // Console.WriteLine("Check Recheck");
                if (processRecheckIfNotFound > Items[processNumber].ReCheckInterval)
                {
                    Console.ForegroundColor = ConsoleColor.Magenta;
                    Console.WriteLine($"Process {processNumber} : processRecheckIfNotFound > processRecheckIfNotFoundMax");
                    Console.ResetColor();
                    processNumber = Items[processNumber].NextStepNotFound;

                    processRecheckIfNotFound = 0;
                    RandomIntBetween = 0;
                    timeCount = 0;
                    // // RoundRunning--;
                    continue;
                }


                if (RandomIntBetween == 0)
                {
                    RandomIntBetween = MouseClickHelper.RandomIntBetween(0, 2);

                }
                var isStillWaitForInterval = timeCount <
                    MouseClickHelper.ConvertSecondToMilisecond(Items[processNumber].Interval) +
                    RandomIntBetween;

                // Console.WriteLine("Check isStillWaitForInterval");
                if (isStillWaitForInterval)
                {
                    await Task.Delay(intervalLoop);
                    timeCount += intervalLoop;

                    continue;
                }

                if (processNumber == 0)
                {
                    RoundRunning--;
                }

                await Task.Delay(100);
                Items[processNumber] = ImageSearch.SearchEqualImageInScreen(Items[processNumber]);

                Console.WriteLine($"Process {processNumber} : IsFound : {Items[processNumber].IsFound}");
                if (Items[processNumber].IsFound)
                {
                    await PlayJingleAsync();
                    var CursorPosition = MouseClickHelper.GetRandomPointInRectangle(Items[processNumber]);
                    MouseOperationsService.SetCursorPosition(CursorPosition.X, CursorPosition.Y);
                    await MouseOperationsService.LeftMouseClick();
                    await Task.Delay(MouseClickHelper.ConvertSecondToMilisecond(Items[processNumber].AfterClick));
                    processNumber = Items[processNumber].NextStepFound;

                    processRecheckIfNotFound = 0;
                    RandomIntBetween = 0;
                    timeCount = 0;
                }
                else
                {
                    Console.ForegroundColor = ConsoleColor.Red;
                    Console.WriteLine($"not found Process: {processNumber} | Recheck {processRecheckIfNotFound}");
                    Console.ResetColor();
                    // await OnStopAutoAsync();
                    processRecheckIfNotFound++;
                }

            }
            catch (Exception ex)
            {
                Console.ForegroundColor = ConsoleColor.DarkRed;
                Console.WriteLine("Error");
                Console.WriteLine(ex);
                Console.ResetColor();
                await OnStopAutoAsync();
            }

            await Task.Delay(intervalLoop);
            timeCount += intervalLoop;

        }
    }
    async Task OnSaveAsync()
    {
        if (Items.Count == 1)
        {
            return;
        }
        await SQLiteContext.InsertImageStep(Items, tableName);

    }
    async Task OnLoadAsync()
    {
        Items = await SQLiteContext.GetAll(tableName);
    }
    async Task OnDropTableAsync()
    {
        if (tableName == "ImageSteps")
        {
            return;
        }
        var tableN = await SQLiteContext.DropTable(tableName);
        ItemsTableName = filteredItemsTableName = tableN;

        tableName = "ImageSteps";
        await OnLoadAsync();

    }
    async Task OnStopAutoAsync()
    {
        isStartLoop = false;
        Console.ForegroundColor = ConsoleColor.Red;
        Console.WriteLine("Stop");
        Console.ResetColor();
        _cts?.Cancel();
    }

