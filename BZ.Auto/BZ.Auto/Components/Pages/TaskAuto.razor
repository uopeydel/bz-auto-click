    private async Task OnChanged(ImageStepModel item, string field, object value)
    {
        try
        {
            switch (field)
            {
                // case nameof(ImageStepModel.BaseImage):
                //     item.BaseImage = value?.ToString();
                //     break;

                // case nameof(ImageStepModel.CurrentFromScreen):
                //     item.CurrentFromScreen = value?.ToString();
                //     break;

                case nameof(ImageStepModel.TopLeftX):
                    item.TopLeftX = Convert.ToInt32(value);
                    break;

                case nameof(ImageStepModel.TopLeftY):
                    item.TopLeftY = Convert.ToInt32(value);
                    break;

                case nameof(ImageStepModel.BotRightX):
                    item.BotRightX = Convert.ToInt32(value);
                    break;

                case nameof(ImageStepModel.BotRightY):
                    item.BotRightY = Convert.ToInt32(value);
                    break;

                case nameof(ImageStepModel.Interval):
                    item.Interval = Convert.ToInt32(value);
                    break;

                case nameof(ImageStepModel.AfterClick):
                    item.AfterClick = Convert.ToInt32(value);
                    break;

                case nameof(ImageStepModel.ReCheckInterval):
                    item.ReCheckInterval = Convert.ToInt32(value);
                    break;

                case nameof(ImageStepModel.NextStepFound):
                    item.NextStepFound = Convert.ToInt32(value);
                    break;

                case nameof(ImageStepModel.NextStepNotFound):
                    item.NextStepNotFound = Convert.ToInt32(value);
                    break;

                case nameof(ImageStepModel.NextStepEveryRound):
                    item.NextStepEveryRound = Convert.ToInt32(value);
                    break;

                case nameof(ImageStepModel.NextStepEveryToStep):
                    item.NextStepEveryToStep = Convert.ToInt32(value);
                    break;

                case nameof(ImageStepModel.Active):
                    item.Active = Convert.ToBoolean(value);
                    break;
                case nameof(ImageStepModel.IsClick):
                    item.IsClick = Convert.ToBoolean(value);
                    break;
                case nameof(ImageStepModel.IsDoubleClick):
                    item.IsDoubleClick = Convert.ToBoolean(value);
                    break; 
                case nameof(ImageStepModel.FourceStopLoop):
                    item.FourceStopLoop = Convert.ToBoolean(value);
                    break;
            }

            // 🔥 ตรงนี้คือ hook ไปทำ logic ต่อ
            await HandleAfterChange(item, field);
        }
        catch { }
    }

