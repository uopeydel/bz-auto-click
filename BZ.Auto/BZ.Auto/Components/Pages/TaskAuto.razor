    #endregion


    public string tableName = "ImageSteps";
    public int processNumber = 0;
    public int RoundRunning = 1;
    public int RoundMax = 9999;
    protected override async Task OnInitializedAsync()
    {
        // mock delay (เช่นโหลดจาก API)
        await Task.Delay(100);

        Items = new List<ImageStepModel>
        {
            new ImageStepModel
