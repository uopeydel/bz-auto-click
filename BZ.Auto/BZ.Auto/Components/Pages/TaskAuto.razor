@code {

    #region autoComplete
    public string ValueAutoCompleteTableName { get; set; } = "";
    public EventCallback<string> ValueChanged { get; set; }
    public List<string> ItemsTableName { get; set; } = new();
    public string PlaceholderAutoComplete { get; set; } = "Type to search...";

    private ElementReference wrapperRef;
    private bool showDropdown = false;
    private int selectedIndex = -1;
    private List<string> filteredItemsTableName = new();

    private async Task OnInput(ChangeEventArgs e)
    {
        tableName = ValueAutoCompleteTableName = e.Value?.ToString() ?? "";
        await ValueChanged.InvokeAsync(ValueAutoCompleteTableName);
        FilterItems();
        showDropdown = filteredItemsTableName.Any();
        selectedIndex = -1;
    }

    private void OnFocus()
    {
        FilterItems();
        showDropdown = filteredItemsTableName.Any();
    }

    private void FilterItems()
    {
        filteredItemsTableName = string.IsNullOrWhiteSpace(ValueAutoCompleteTableName)
        ? ItemsTableName.ToList()
        : ItemsTableName.Where(x => x.Contains(ValueAutoCompleteTableName, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private async Task SelectItem(string item)
    {
        tableName = ValueAutoCompleteTableName = item;
        await ValueChanged.InvokeAsync(ValueAutoCompleteTableName);
        showDropdown = false;
        selectedIndex = -1;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        // if (!showDropdown) return;

        switch (e.Key)
        {
            case "ArrowDown":
                selectedIndex = Math.Min(selectedIndex + 1, filteredItemsTableName.Count - 1);
                break;
            case "ArrowUp":
                selectedIndex = Math.Max(selectedIndex - 1, -1);
                break;
            case "Enter":
                if (selectedIndex >= 0 && selectedIndex < filteredItemsTableName.Count)
                { await SelectItem(filteredItemsTableName[selectedIndex]); }
                else
                {
                    tableName = ValueAutoCompleteTableName;
                    showDropdown = false;
                }
                break;
            case "Escape":
                showDropdown = false;
                selectedIndex = -1;
                break;
        }
    }
    #endregion

    #region  Volume
    record VolumeStep(string Icon, string Desc, double Value);

    private readonly VolumeStep[] _steps =
    [
        new("🔊", "เสียงเต็ม",  1),
        new("🔉", "เสียงกลาง", 0.5),
        new("🔈", "ปิดเสียง",   0),
    ];

    private int _idx = 0;
    private VolumeStep _currentVolumn => _steps[_idx];

    private void Cycle()
    {
        _idx = (_idx + 1) % _steps.Length;
    }

    private async Task PlayJingleAsync()
    {
        try
        {
            // await PlayJingleAsync(0.5);  // 50%
            // await PlayJingleAsync(0.2);  // เบามาก
