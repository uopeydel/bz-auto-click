<h3>Task Auto</h3>
@using BZ.Auto.Models
@using System.Threading.Tasks
@using BZ.Auto.Service
@using Microsoft.Data.Sqlite;
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject MouseHookService HookService
@page "/task-auto"
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration


randomWait : @randomWait  | timeCount: @timeCount
<br />
<p class="@(comboNotFound > limitForComboNotFound ? "text-danger" : "text-success")">
    combo not found : @comboNotFound / @limitForComboNotFound
</p>
<div class="col-12 col-md-8 control-bar">

    <!-- แถวที่ 1 -->
    <div class="d-flex flex-wrap gap-2 align-items-end">

        <!-- Next Munite shut down -->
        <div class="d-flex flex-column align-items-center">
            <label class="form-label small mb-1">Next Minute Shutdown</label>
            <input type="number" class="form-control form-control-sm" style="width:100px"
                   @bind="NextMinuteShutdown" />
        </div>

        <!-- confident -->
        <div class="d-flex flex-column align-items-center">
            <label class="form-label small mb-1">confidentn</label>
            <input type="number" class="form-control form-control-sm" style="width:100px"
                   @bind="Confident" max="100" min="90" />
        </div>


        <!-- Add -->
        <div class="d-flex flex-column align-items-center">
            <label class="form-label small mb-1">Set Shutdown</label>
            <button type="button" class="btn btn-danger btn-sm" style="width:100px"
                    disabled="@(isStartLoop || HookService.IsHookActive )" @onclick="async () => await OnSetShutdown()">
                ⏰ Set Shutdown
            </button>
        </div>



        <!-- Volume -->
        <div class="d-flex flex-column align-items-center">
            <label class="form-label small mb-1">Volume</label>
            <button type="button" class="btn btn-success btn-sm" style="width:100px" @onclick="() => Cycle()">
                @_currentVolumn.Icon @_currentVolumn.Desc
            </button>
        </div>

        <!-- Round Max -->
        <div class="d-flex flex-column align-items-center">
            <label class="form-label small mb-1">Round Max</label>
            <input type="number" class="form-control form-control-sm" style="width:100px"
                   @bind="RoundMax" @bind:event="oninput" min="1" max="9999" step="1" />
        </div>
        <!-- Round Running -->
        <div class="d-flex flex-column align-items-center">
            <label class="form-label small mb-1">Running</label>
            <input type="number" class="form-control form-control-sm" style="width:100px"
                   @bind="RoundRunning" readonly />
        </div>

        <!-- Add -->
        <div class="d-flex flex-column align-items-center">
            <label class="form-label small mb-1">Add Row</label>
            <button type="button" class="btn btn-primary btn-sm" style="width:100px"
                    disabled="@(isStartLoop || HookService.IsHookActive )" @onclick="() => AddRow()">
                ➕ Add
            </button>
        </div>

        <!-- Start -->
        <div class="d-flex flex-column align-items-center">
            <label class="form-label small mb-1">Start</label>
            <button type="button" class="btn btn-success btn-sm" style="width:100px"
                    disabled="@((isStartLoop || HookService.IsHookActive  || !isLockSave))" @onclick="async () => await OnStartAutoAsync()">
                🔄 Start
            </button>
        </div>

        <!-- Stop -->
        <div class="d-flex flex-column align-items-center">
            <label class="form-label small mb-1">Stop</label>
            <button type="button" class="btn btn-danger btn-sm" style="width:100px"
                    @onclick="async () => await OnStopAutoAsync()">
                ❌ Stop
            </button>
        </div>

        <!-- Load -->
        <div class="d-flex flex-column align-items-center">
            <label class="form-label small mb-1">Load</label>
            <button type="button" class="btn btn-primary btn-sm" style="width:100px"
                    disabled="@(isStartLoop || HookService.IsHookActive  || isLockSave)" @onclick="async () => await OnLoadAsync()">
                📂 Load
            </button>
        </div>

        <!-- Save -->
        <div class="d-flex flex-column align-items-center">
            <label class="form-label small mb-1">Save</label>
            <button type="button" class="btn btn-success btn-sm" style="width:100px"
                    disabled="@(isStartLoop || HookService.IsHookActive  || isLockSave)" @onclick="async () => await OnSaveAsync()">
                💾 Save
            </button>
        </div>

        <div class="d-flex flex-column align-items-center">
            <label class="form-label small mb-1">Lock Save</label>
            <button type="button" class="btn btn-danger btn-sm" style="width:100px"
                    disabled="@(isStartLoop || HookService.IsHookActive )" @onclick="async () => await OnLockSaveAsync()">
                🔒 Lock Save
            </button>
        </div>


        <!-- Interval -->
        @if (true)
        {
            <div class="d-flex flex-column align-items-center">
                <label class="form-label small mb-1">Interval (ms)</label>
                <input type="number" class="form-control form-control-sm" style="width:100px"
                       @bind="intervalLoop" @bind:event="oninput" min="5" />
            </div>
        }

        <!-- Save Name -->
        <div class="d-flex flex-column align-items-center">
            <label class="form-label small mb-1">Save Name</label>
            <div class="autocomplete-wrapper d-flex gap-1 align-items-center" @ref="wrapperRef">
                <input type="text"
                       class="form-control form-control-sm"
                       style="width:360px"
                       value="@ValueAutoCompleteTableName"
                       @oninput="OnInput"
                       @onfocus="OnFocus"
                       @onkeydown="OnKeyDown"
                       placeholder="@PlaceholderAutoComplete"
                       autocomplete="off" />
                <button class="btn btn-outline-danger btn-sm" @onclick="async () => await OnDropTableAsync()">🗑</button>
                @if (showDropdown && filteredItemsTableName.Any())
                {
                    <ul class="autocomplete-dropdown">
                        @foreach (var (item, index) in filteredItemsTableName.Select((item, i) => (item, i)))
                        {
                            <li class="autocomplete-item @(index == selectedIndex ? "active" : "")"
                                @onmousedown="() => SelectItem(item)">
                                @item
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <!-- Start -->
        <div class="d-flex flex-column align-items-center">
            <label class="form-label small mb-1">Start</label>
            <button type="button" class="btn btn-success btn-sm" style="width:100px" disabled="@(HookService.IsHookActive  || isStartLoop)"
                    @onclick="async () => await StartHook()">
                ▶ Hook
            </button>
        </div>

        <!-- Stop -->
        <div class="d-flex flex-column align-items-center">
            <label class="form-label small mb-1">Stop</label>
            <button type="button" class="btn btn-danger btn-sm" style="width:100px" disabled="@(!HookService.IsHookActive  || isStartLoop)"
                    @onclick="() => StopHook()">
                ⏹ Release
            </button>
        </div>

        <div class="d-flex flex-column align-items-center" style="width:200px">
            <label class="form-label small mb-1">Position</label>
            <button type="button" class="btn btn-sm btn-outline-secondary" style="width:200px"
                    @onclick='() => Position = Position == "TopLeft" ? "BotRight" : "TopLeft"'>
                🔄 @(Position == "TopLeft" ? "Top Left" : "Bot Right")
            </button>
        </div>

    </div>
</div>

<br />



@if (isModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered"
             style="width: fit-content; max-width: 95vw; margin: auto;">
            <div class="modal-content" style="width: fit-content;">

                <button type="button" class="btn-close"
                        @onclick="CloseModal"
                        style="position: absolute; top: 8px; right: 8px; z-index: 10;">
                </button>

                <div class="modal-body p-0">
                    <img src="@currentImage"
                         style="
                                                                                                 display: block;
                                                                                                 width: 600px;
                                                                                                 max-height: 800px;
                                                                                                 object-fit: contain;" />
                </div>

                <div class="modal-footer justify-content-center py-2">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseModal">
                        Close
                    </button>
                </div>

            </div>
        </div>
    </div>

}


<br />
<table class="table table-bordered">

    <thead>
        <tr>
            <th>Step</th>
            <th>BaseImage</th>
            <th>Current From Screen</th>

            <th>Log</th>

            <th>TopLeftX</th>
            <th>TopLeftY</th>
            <th>BotRightX</th>
            <th>BotRightY</th>
            <th>Before Click Interval (sec)</th>
            <th>After Click Interval (sec)</th>
            <th>ReCheck NotFound (Count)</th>
            <th>NextStep (Found)</th>
            <th>NextStep (NotFound)</th>
            <th>NextStep (Every ToStep)</th>
            <th>NextStep (Every Round)</th>
            <th>Active</th>
            <th>DoubleClick</th>
            <th>FourceStopLoop</th>
        </tr>
    </thead>
    <tbody>

        @foreach (var pair in Items.Select((item, index) => new { item, index }))
        {
            <tr class="@(processNumber == pair.index ? pair.item.IsFound == true ? "row-selected" : "row-selected-error" : "")">
                <td @onclick="() => OnIndexClick(pair.item, pair.index)" style="cursor:pointer" disabled="@isLockSave">
                    @pair.index
                </td>

                <!-- BaseImage -->
                <td>

                    <button type="button" @onclick="() => OnImageClick(pair.item)" style="border:none; background:none; padding:0;" disabled="@isLockSave">
                        <img src="@GetImageSrc(pair.item.BaseImage)" width="200" height="50" style="cursor:pointer" />
                    </button>

                </td>

                <!-- CurrentFromScreen -->
                <td>

                    <img src="@GetImageSrc(pair.item.CurrentFromScreenSmallToCompare)" @onclick="() => OnImageScreenClick(pair.item)"
                         width="200" height="50" />
                </td>

                <td>
                    <p style="white-space: nowrap;margin :  0px !important;">match: @((int)(pair.item.Confidence * 100)) %</p>
                    <p style="white-space: nowrap;margin :  0px !important;">scale: @((int)(pair.item.Scale * 100)) %</p>
                    <p style="white-space: nowrap;color:red;margin :  0px !important;">combo: @((int)(pair.item.ComboNotFound))</p>
                </td>

                <!-- int fields -->
                <td>
                    <input type="number" class="form-control" disabled="@isLockSave"
                           value="@pair.item.TopLeftX"
                           @onchange="e => OnChanged(pair.item, nameof(pair.item.TopLeftX), e.Value)" />
                </td>

                <td>
                    <input type="number" class="form-control" disabled="@isLockSave"
                           value="@pair.item.TopLeftY"
                           @onchange="e => OnChanged(pair.item, nameof(pair.item.TopLeftY), e.Value)" />
                </td>

                <td>
                    <input type="number" class="form-control" disabled="@isLockSave"
                           value="@pair.item.BotRightX"
                           @onchange="e => OnChanged(pair.item, nameof(pair.item.BotRightX), e.Value)" />
                </td>

                <td>
                    <input type="number" class="form-control" disabled="@isLockSave"
                           value="@pair.item.BotRightY"
                           @onchange="e => OnChanged(pair.item, nameof(pair.item.BotRightY), e.Value)" />
                </td>

                <td>
                    <input type="number" class="form-control" disabled="@isLockSave"
                           value="@pair.item.Interval"
                           @onchange="e => OnChanged(pair.item, nameof(pair.item.Interval), e.Value)" />
                </td>

                <td>
                    <input type="number" class="form-control" disabled="@isLockSave"
                           value="@pair.item.AfterClick"
                           @onchange="e => OnChanged(pair.item, nameof(pair.item.AfterClick), e.Value)" />
                </td>

                <td>
                    <input type="number" class="form-control" disabled="@isLockSave"
                           value="@pair.item.ReCheckInterval"
                           @onchange="e => OnChanged(pair.item, nameof(pair.item.ReCheckInterval), e.Value)" />
                </td>

                <td>
                    <input type="number" class="form-control" disabled="@isLockSave"
                           value="@pair.item.NextStepFound"
                           @onchange="e => OnChanged(pair.item, nameof(pair.item.NextStepFound), e.Value)" />
                </td>

                <td>
                    <input type="number" class="form-control" disabled="@isLockSave"
                           value="@pair.item.NextStepNotFound"
                           @onchange="e => OnChanged(pair.item, nameof(pair.item.NextStepNotFound), e.Value)" />
                </td>


                <td>
                    <input type="number" class="form-control" disabled="@isLockSave"
                           value="@pair.item.NextStepEveryToStep"
                           @onchange="e => OnChanged(pair.item, nameof(pair.item.NextStepEveryToStep), e.Value)" />

                </td>

                <td>
                    <input type="number" class="form-control" disabled="@isLockSave"
                           value="@pair.item.NextStepEveryRound"
                           @onchange="e => OnChanged(pair.item, nameof(pair.item.NextStepEveryRound), e.Value)" />

                    <p style="white-space: nowrap;color:red;margin :  0px !important;">@((int)(pair.item.NextStepEveryRoundCount)) / @((int)(pair.item.NextStepEveryRoundRandomAdjustRound))</p>
                </td>


                <!-- bool -->
                <td class="text-center">
                    <input type="checkbox" disabled="@isLockSave" 
                           checked="@pair.item.Active"
                           @onchange="e => OnChanged(pair.item, nameof(pair.item.Active), e.Value)" />
                    <input type="checkbox" disabled="@isLockSave"
                           checked="@pair.item.IsClick"
                           @onchange="e => OnChanged(pair.item, nameof(pair.item.IsClick), e.Value)" />

                </td>

                <!-- bool -->
                <td class="text-center"> 
                    <input type="checkbox" disabled="@isLockSave"
                           checked="@pair.item.IsDoubleClick"
                           @onchange="e => OnChanged(pair.item, nameof(pair.item.IsDoubleClick), e.Value)" />

                </td>

                <td class="text-center">
                    <input type="checkbox" disabled="@isLockSave"
                           checked="@pair.item.FourceStopLoop"
                           @onchange="e => OnChanged(pair.item, nameof(pair.item.FourceStopLoop), e.Value)" />
                </td>

                <td>
                    <button disabled="@isLockSave"
                            class="btn btn-danger btn-sm" @onclick="() => Remove(pair.item, pair.index)">
                        Delete
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>


@code {

    #region

    private async Task StartHook()
    {
        await InvokeAsync(StateHasChanged);
        HookService.Start();
    }
    private void StopHook()
    {
        HookService.Stop();
    }

    private string Position = "TopLeft";
    private int counter = 0;
    private List<(int Index, int X, int Y)> positions = new();
    private void HandleSpacePressed(int x, int y)
    {
        if (Position == "TopLeft")
        {
            Items[processNumber].TopLeftX = x;
            Items[processNumber].TopLeftY = y;
        }
        else if (Position == "BotRight")
        {
            Items[processNumber].BotRightX = x;
            Items[processNumber].BotRightY = y;
        }
        positions.Add((++counter, x, y));

        // ต้อง InvokeAsync เพราะ event มาจาก thread อื่น
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        // Unsubscribe เมื่อออกจากหน้า
        HookService.OnSpacePressed -= HandleSpacePressed;
    }

    #endregion

    #region autoComplete
    public string ValueAutoCompleteTableName { get; set; } = "";
    public EventCallback<string> ValueChanged { get; set; }
    public List<string> ItemsTableName { get; set; } = new();
    public string PlaceholderAutoComplete { get; set; } = "Type to search...";

    private ElementReference wrapperRef;
    private bool showDropdown = false;
    private int selectedIndex = -1;
    private List<string> filteredItemsTableName = new();

    private async Task OnInput(ChangeEventArgs e)
    {
        tableName = ValueAutoCompleteTableName = e.Value?.ToString() ?? "";
        await ValueChanged.InvokeAsync(ValueAutoCompleteTableName);
        FilterItems();
        showDropdown = filteredItemsTableName.Any();
        selectedIndex = -1;
    }

    private void OnFocus()
    {
        FilterItems();
        showDropdown = filteredItemsTableName.Any();
    }

    private void FilterItems()
    {
        filteredItemsTableName = string.IsNullOrWhiteSpace(ValueAutoCompleteTableName)
        ? ItemsTableName.ToList()
        : ItemsTableName.Where(x => x.Contains(ValueAutoCompleteTableName, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private async Task SelectItem(string item)
    {
        tableName = ValueAutoCompleteTableName = item;
        await ValueChanged.InvokeAsync(ValueAutoCompleteTableName);
        showDropdown = false;
        selectedIndex = -1;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        // if (!showDropdown) return;

        switch (e.Key)
        {
            case "ArrowDown":
                selectedIndex = Math.Min(selectedIndex + 1, filteredItemsTableName.Count - 1);
                break;
            case "ArrowUp":
                selectedIndex = Math.Max(selectedIndex - 1, -1);
                break;
            case "Enter":
                if (selectedIndex >= 0 && selectedIndex < filteredItemsTableName.Count)
                { await SelectItem(filteredItemsTableName[selectedIndex]); }
                else
                {
                    tableName = ValueAutoCompleteTableName;
                    showDropdown = false;
                }
                break;
            case "Escape":
                showDropdown = false;
                selectedIndex = -1;
                break;
        }
    }
    #endregion

    #region  Volume
    record VolumeStep(string Icon, string Desc, double Value);

    private readonly VolumeStep[] _steps =
    [
        new("🔊", "100%",  1),
        new("🔉", "50%", 0.5),
        new("🔈", "0%",   0),
    ];

    private int _idx = 0;
    private VolumeStep _currentVolumn => _steps[_idx];

    private void Cycle()
    {
        _idx = (_idx + 1) % _steps.Length;
    }

    private async Task PlayJingleAsync()
    {
        try
        {
            // await PlayJingleAsync(0.5);  // 50%
            // await PlayJingleAsync(0.2);  // เบามาก
            // await PlayJingleAsync(1.0);  // ดังสุด (default)
            // await JS.InvokeVoidAsync("playJingle", "sounds/jingle.wav", _currentVolumn.Value);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Sound error: {ex.Message}");
        }
    }
    #endregion


    int Confident = 99;
    public string tableName = "ImageSteps";
    public int processNumber = 0;
    public int RoundRunning = 1;
    public int RoundMax = 9000;
    protected override async Task OnInitializedAsync()
    {
        // mock delay (เช่นโหลดจาก API)
        await Task.Delay(100);

        Items = new List<ImageStepModel>
        {
            new ImageStepModel
            {
                BaseImage = ImageCapture.Default,
                CurrentFromScreenSmallToCompare = ImageCapture.Default,
                TopLeftX = 10,
                TopLeftY = 20,
                BotRightX = 100,
                BotRightY = 200,
                Interval = 5,
                AfterClick = 0,
                ReCheckInterval = 2,
                NextStepFound = 0,
                NextStepNotFound = 0,
                NextStepEveryRound = 0,
                NextStepEveryToStep = 0,
                Active = true,
            IsClick = true,
                FourceStopLoop = false
            }
        };

        try
        {
            string? _RoundMax = await JS.InvokeAsync<string>(
                            "localStorageHelper.getItem",
                            "RoundMax");
            if (!string.IsNullOrEmpty(_RoundMax))
            {
                var isRoundMaxInt = int.TryParse(_RoundMax, out int __RoundMax);
                if (isRoundMaxInt)
                {
                    RoundMax = __RoundMax;
                }
            }
            string? _tableName = await JS.InvokeAsync<string>(
                "localStorageHelper.getItem",
                "tableName");
            if (!string.IsNullOrEmpty(_tableName))
            {
                tableName = _tableName;
            }

            ValueAutoCompleteTableName = tableName;
            var tableN = await SQLiteContext.ListTableName();
            ItemsTableName = filteredItemsTableName = tableN;
            await OnLoadAsync();

            #region mouse hook
            // Subscribe event จาก Service
            HookService.OnSpacePressed += HandleSpacePressed;
            #endregion
        }
        catch
        {

        }
    }

    void Remove(ImageStepModel item, int indx)
    {
        for (int i = 0; i < Items.Count; i++)
        {
            if (Items[i].NextStepEveryToStep > indx)
            {
                Items[i].NextStepEveryToStep--;
            }

            if (Items[i].NextStepFound > indx)
            {
                Items[i].NextStepFound--;
            }

            if (Items[i].NextStepNotFound > indx)
            {
                Items[i].NextStepNotFound--;
            }

        }
        Items.Remove(item);
    }

    void AddRow()
    {
        Items.Add(new ImageStepModel
        {
            BaseImage = ImageCapture.Default,
            CurrentFromScreenSmallToCompare = ImageCapture.Default,
            TopLeftX = 10,
            TopLeftY = 20,
            BotRightX = 100,
            BotRightY = 200,
            Interval = 5,
            AfterClick = 0,
            ReCheckInterval = 2,
            NextStepFound = 0,
            NextStepNotFound = 0,
            NextStepEveryRound = 0,
            NextStepEveryToStep = 0,
            Active = true,
            IsClick = true,
            FourceStopLoop = false
        });
    }

    int NextMinuteShutdown = 120;
    static DateTime targetTimeFourceStop = DateTime.Now.AddDays(10);
    async Task OnSetShutdown()
    {

        try
        {
            DateTime now = DateTime.Now;
            DateTime targetTime = now.AddMinutes(NextMinuteShutdown); // เวลาที่ต้องการเทียบ

            targetTimeFourceStop = targetTime;
            targetTimeFourceStop = targetTimeFourceStop.AddMinutes(-10);

            int diffSeconds = NextMinuteShutdown * 60;

            Console.WriteLine($"Shut down in {diffSeconds}");


            var psi = new System.Diagnostics.ProcessStartInfo("shutdown", $"-s -f -t {diffSeconds}");
            psi.CreateNoWindow = true;
            psi.UseShellExecute = false;
            System.Diagnostics.Process.Start(psi);

            var discordUrl = Configuration["DiscordSettings:WebhookUrl"];
            var BotName = Configuration["DiscordSettings:BotName"];

            await DiscordNotificationService.SendNotification(
                discordUrl,
                BotName,
                RoundRunning,
                $"Shut down in {targetTime.ToString("yyyy-MM-dd HH:mm:sss")}");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
    }

    // public int countForEvery = 0;
    // public int randomAdjustRound = 0;
    public int timeCount = 0;
    public int randomWait = 0;
    public int intervalLoop = 5;
    public int processRecheckIfNotFound = 0;
    public int processRecheckIfNotFoundMax = 3;

    public int limitForComboNotFound = 0;
    public int comboNotFound = 0;
    static bool isStartLoop = false;
    bool isLockSave = true;
    static CancellationTokenSource _cts;
    async Task OnStartAutoAsync()
    {
        ImageSearch.Confidence = (((double)Confident) / (double)100);
        await JS.InvokeVoidAsync("unlockAudio");


        await JS.InvokeVoidAsync(
                "localStorageHelper.setItem",
                "RoundMax",
                RoundMax);


        int RandomIntBetween = 0;
        timeCount = 0;
        processRecheckIfNotFound = 0;
        Console.ForegroundColor = ConsoleColor.Green;
        Console.WriteLine("Start");
        Console.ResetColor();
        processNumber = 0;
        RoundRunning = RoundMax;
        isStartLoop = true;
        DateTime startTime = DateTime.Now;
        _cts = new CancellationTokenSource();

        comboNotFound = 0;
        limitForComboNotFound = Items.Select(s => s.ReCheckInterval).Sum() * 3;

        List<string> messages = new List<string>();
        while (!_cts.Token.IsCancellationRequested && isStartLoop)
        {
            try
            {
                await InvokeAsync(StateHasChanged);

                if (Items[processNumber].FourceStopLoop == true)
                {
                    var discordUrl = Configuration["DiscordSettings:WebhookUrl"];
                    var BotName = Configuration["DiscordSettings:BotName"];

                    await DiscordNotificationService.SendNotification(
                        discordUrl,
                        BotName,
                        RoundRunning,
                        "ติด Fource Stop Loop");
                    RoundRunning = 0;
                    processRecheckIfNotFound = 0;
                    processNumber = 0;
                    await OnStopAutoAsync();
                    await JS.InvokeVoidAsync("playJingle", "sounds/danger-alert.mp3", _currentVolumn.Value);
                    return;
                }

                if (targetTimeFourceStop <= DateTime.Now)
                {
                    var discordUrl = Configuration["DiscordSettings:WebhookUrl"];
                    var BotName = Configuration["DiscordSettings:BotName"];

                    await DiscordNotificationService.SendNotification(
                        discordUrl,
                        BotName,
                        RoundRunning,
                        "อีก 10 นาทีถึงเวลา shut down");
                    RoundRunning = 0;
                    processRecheckIfNotFound = 0;
                    processNumber = 0;
                    await OnStopAutoAsync(); 
                    return;
                }

                // Console.WriteLine("Check RoundCount");
                if (RoundRunning <= 0)
                {
                    Console.ForegroundColor = ConsoleColor.Yellow;
                    Console.WriteLine($"Process {processNumber} : RoundCount <= 0");
                    Console.ResetColor();
                    await OnStopAutoAsync();
                    return;
                }

                // Console.WriteLine("Check processNumber");
                if (processNumber == Items.Count())
                {
                    Console.ForegroundColor = ConsoleColor.DarkYellow;
                    Console.WriteLine($"Process {processNumber} : processNumber >= Items.Count()");
                    Console.ResetColor();
                    processRecheckIfNotFound = 0;
                    processNumber = 0;
                    // // RoundRunning--;
                    RandomIntBetween = 0;
                    timeCount = 0;
                    continue;
                }

                // Console.WriteLine("Check Recheck");
                if (processRecheckIfNotFound > Items[processNumber].ReCheckInterval)
                {
                    Console.ForegroundColor = ConsoleColor.Magenta;
                    Console.WriteLine($"Process {processNumber} : processRecheckIfNotFound > processRecheckIfNotFoundMax");
                    Console.ResetColor();
                    processNumber = Items[processNumber].NextStepNotFound;

                    processRecheckIfNotFound = 0;
                    RandomIntBetween = 0;
                    timeCount = 0;
                    // // RoundRunning--;
                    continue;
                }


                if (RandomIntBetween == 0)
                {
                    RandomIntBetween = MouseClickHelper.RandomIntBetween(0, 2);
                }

                bool isStillWaitForInterval = false;
                var beforeClickInterval = Items[processNumber].Interval;
                // ตั้งไว้เผื่ออยากให้จำนวนวิเยอะๆถึงทำการ random adjust
                if (beforeClickInterval > 5)
                {
                    isStillWaitForInterval = timeCount <
                    MouseClickHelper.ConvertSecondToMilisecond(beforeClickInterval) +
                    RandomIntBetween;
                }

                // Console.WriteLine("Check isStillWaitForInterval");
                if (isStillWaitForInterval)
                {
                    await Task.Delay(intervalLoop);
                    timeCount += intervalLoop;
                    continue;
                }

                Console.WriteLine();
                Console.WriteLine("DateTime:" + DateTime.Now);
                Console.ForegroundColor = ConsoleColor.Cyan;
                Console.WriteLine($"Process :{processNumber} | Round {RoundRunning} / {RoundMax}");
                Console.ResetColor();


                Console.ForegroundColor = ConsoleColor.Magenta;
                Console.WriteLine($"TimeCount before check image {timeCount} ms");
                Console.ResetColor();
                if (processNumber == 0)
                {
                    RoundRunning--;
                    if (RoundRunning % 17 == 0 || RoundRunning % 27 == 0 || RoundRunning % 37 == 0)
                    {
                        // await JS.InvokeVoidAsync("playJingle", "sounds/jingle.wav", _currentVolumn.Value);
                        randomWait = MouseClickHelper.RandomIntBetween(3, 7);
                        await Task.Delay(randomWait);
                        // await JS.InvokeVoidAsync("playJingle", "sounds/jingle.wav", _currentVolumn.Value);
                    }
                }

                if (comboNotFound >= limitForComboNotFound)
                {
                    var discordUrl = Configuration["DiscordSettings:WebhookUrl"];
                    var BotName = Configuration["DiscordSettings:BotName"];

                    await DiscordNotificationService.SendNotification(
                        discordUrl,
                        BotName,
                        RoundRunning,
                        "Combo Not Found");
                    await Task.Delay(500);
                    await OnStopAutoAsync();
                    continue;
                }
                Items[processNumber] = ImageSearch.SearchEqualImageInScreen(Items[processNumber]);

                Console.WriteLine($"Process {processNumber} : IsFound : {Items[processNumber].IsFound}");
                var isFound = Items[processNumber].IsFound;
                var itemConfidenceOverSetting = Items[processNumber].Confidence > ImageSearch.Confidence;
                if (isFound && itemConfidenceOverSetting)
                {

                    Console.WriteLine("Items IsClick {0}", Items[processNumber].IsClick);
                    if (Items[processNumber].IsClick)
                    {
                        if (Items[processNumber].ComboNotFound >= 3)
                        {
                            comboNotFound = 0;
                            Items[processNumber].ComboNotFound = 0;
                        }

                        // await PlayJingleAsync();
                        var CursorPosition = MouseClickHelper.GetRandomPointInRectangle(Items[processNumber]);

                        var current = MouseOperationsService.GetCursorPosition();
                        //MouseMover.MoveSmooth(current.X, current.Y, CursorPosition.X, CursorPosition.Y, speedPxPerSec: 2500);

                        
                        MouseMover.MoveAbsolute(CursorPosition.X, CursorPosition.Y);
                        // // // MouseMover.MoveSmooth(current.X, current.Y, CursorPosition.X, CursorPosition.Y,
                        // // //    speedPxPerSec: 50000, smoothness: 6);


                        // Console.ForegroundColor = ConsoleColor.Yellow;
                        // var ranDomBeforeClick = MouseClickHelper.RandomIntBetween(0, 6, 50);
                        // Console.WriteLine($"Random Before Click {ranDomBeforeClick} ms");
                        // await Task.Delay(ranDomBeforeClick);
                        // Console.ResetColor();

                        Console.WriteLine("Items LeftMouseClick");
                        // MouseOperationsService.SetCursorPosition(CursorPosition.X, CursorPosition.Y);
                        @* await Task.Delay(MouseOperationsService.GenerateRandomMillisecond(0.10, 0.18)); *@
                        await MouseOperationsService.LeftMouseClick();
                       
                        if ((Items[processNumber].AfterClick > 1 && Items[processNumber].Interval > 1) || Items[processNumber].IsDoubleClick)
                        {
                            await Task.Delay(MouseOperationsService.GenerateRandomMillisecond(0.10, 0.18));
                            await MouseOperationsService.LeftMouseClick();
                        }
/*
                        if (processNumber == 14)
                        {
                            await Task.Delay(MouseClickHelper.ConvertSecondToMilisecond(Items[processNumber].AfterClick));
                            await MouseOperationsService.LeftMouseClick();
                            await OnStopAutoAsync(); Console.WriteLine("OnStopAutoAsync");
                        }
                        */
                        if (Items[processNumber].AfterClick > 0)
                        {
                            await Task.Delay(MouseClickHelper.ConvertSecondToMilisecond(Items[processNumber].AfterClick));
                        }

                    }
                    // ถ้ามีการตั้ง เลขรอบที่จะไปที่อื่น
                    // และยังไม่ได้ random adjust round
                    // ตั้ง NextStepEveryRound > 5 ไว้เผื่อจำนวนรอบน้อยๆ อยาก fix รอบ
                    if (Items[processNumber].NextStepEveryRoundRandomAdjustRound == 0
                            && Items[processNumber].NextStepEveryRound > 5)
                    {
                        // ทำการ random adjust round max
                        Items[processNumber].NextStepEveryRoundRandomAdjustRound =
                            Items[processNumber].NextStepEveryRound +
                            MouseClickHelper.RandomIntBetween(0, Items[processNumber].NextStepEveryRound, 1);
                    }

                    // เมื่อจำนวนรอบที่วนผ่านมาเจอรูปนี้ มากกว่า max รอบที่กำหนด
                    // และจำนวนรอบ ที่ตั้งไว้ตอนแรก มากกว่า 0 ก็คือมีการกำหนดรอบ
                    if (Items[processNumber].NextStepEveryRoundCount >= Items[processNumber].NextStepEveryRoundRandomAdjustRound
                        && Items[processNumber].NextStepEveryRound > 0)
                    {
                        // เคลียค่าการนับรอบ
                        Items[processNumber].NextStepEveryRoundRandomAdjustRound = 0;
                        Items[processNumber].NextStepEveryRoundCount = 0;

                        //ไปหาตำแหน่ง process ที่กำหนดไว้
                        processNumber = Items[processNumber].NextStepEveryToStep;
                    }
                    else
                    {
                        //ถ้ามีตั้งจำนวนรอบไว้ ถึงจะนับรอบผ่านทาง
                        if (Items[processNumber].NextStepEveryRound > 0)
                        {
                            // เมื่อ IsFound แล้ว ของโปรเซสนี้ จะ นับว่า ผ่านมาทางนี้แล้วกี่รอบ
                            Items[processNumber].NextStepEveryRoundCount++;
                        }

                        processNumber = Items[processNumber].NextStepFound;
                    }
                    processRecheckIfNotFound = 0;
                    RandomIntBetween = 0;
                    timeCount = 0;
                }
                else
                {
                    if (Items[processNumber].IsClick)
                    {
                        if (processNumber > 1)
                        {
                            comboNotFound++;
                        }
                        Items[processNumber].ComboNotFound++;
                    }
                    else
                    {
                        limitForComboNotFound++;
                    }


                    Console.ForegroundColor = ConsoleColor.Red;
                    Console.WriteLine($"not found Process: {processNumber} | Recheck {processRecheckIfNotFound}");
                    Console.ResetColor();
                    // await OnStopAutoAsync();
                    processRecheckIfNotFound++;
                }

            }
            catch (Exception ex)
            {
                Console.ForegroundColor = ConsoleColor.DarkRed;
                Console.WriteLine("Error");
                Console.WriteLine(ex);
                Console.ResetColor();
                await OnStopAutoAsync();
            }

            await Task.Delay(intervalLoop);
            timeCount += intervalLoop;

        }
    }
    async Task OnSaveAsync()
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm",
            "Confirm save?");

        if (confirmed)
        {
            // กด OK
            Console.WriteLine("Save");
            if (Items.Count == 1)
            {
                return;
            }
            await SQLiteContext.InsertImageStep(Items, tableName);

        }
        else
        {
            // กด Cancel
            Console.WriteLine("Cancel");
        }
    }


    async Task OnLockSaveAsync()
    {
        isLockSave = !isLockSave;

    }

    async Task OnLoadAsync()
    {
        await JS.InvokeVoidAsync(
                "localStorageHelper.setItem",
                "tableName",
                tableName);
        Items = await SQLiteContext.GetAll(tableName);
    }
    async Task OnDropTableAsync()
    {
        if (tableName == "ImageSteps")
        {
            return;
        }
        var tableN = await SQLiteContext.DropTable(tableName);
        ItemsTableName = filteredItemsTableName = tableN;

        tableName = "ImageSteps";
        await OnLoadAsync();

    }
    async Task OnStopAutoAsync()
    {
        isStartLoop = false;
        Console.ForegroundColor = ConsoleColor.Red;
        Console.WriteLine("Stop");
        Console.ResetColor();
        _cts?.Cancel();
    }

