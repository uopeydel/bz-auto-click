    <div class="autocomplete-wrapper" @ref="wrapperRef" width="200">
        <span>Save Name</span>
        <button @onclick="async () => await OnDropTableAsync()">🗑</button>
        <input type="text" width="200"
               class="autocomplete-input"
               value="@ValueAutoCompleteTableName"
               @oninput="OnInput"
               @onfocus="OnFocus"
               @onkeydown="OnKeyDown"
               placeholder="@PlaceholderAutoComplete"
               autocomplete="off" />

        @if (showDropdown && filteredItemsTableName.Any())
        {
            <ul class="autocomplete-dropdown">
                @foreach (var (item, index) in filteredItemsTableName.Select((item, i) => (item, i)))
                {
                    <li class="autocomplete-item @(index == selectedIndex ? "active" : "")"
                        @onmousedown="() => SelectItem(item)">
                        @item
                    </li>

                }
            </ul>
        }
    </div>


