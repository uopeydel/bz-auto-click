    <button type="button" class="btn btn-danger" disabled="@(!isStartLoop)"
            @onclick="async () => await OnStopAutoAsync()">
        ❌ Stop
    </button>

    <button type="button" class="btn btn-primary" disabled="@(isStartLoop)"
            @onclick="async () => await OnLoadAsync()">
        📂 Load
    </button>

    <button type="button" class="btn btn-success" disabled="@(isStartLoop)"
            @onclick="async () => await OnSaveAsync()">
