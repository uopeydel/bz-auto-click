    string GetImageSrc(string base64)
    {
        if (string.IsNullOrEmpty(base64)) return "";

        if (base64.StartsWith("data:"))
            return base64;

        return $"data:image/png;base64,{base64}";
    }
    private bool isModalOpen = false;
    private string currentImage = "";

    void ShowImageModal(string base64)
    {
        currentImage = base64;
        isModalOpen = true;
    }

    void CloseModal()
    {
        isModalOpen = false;
    }
    void OnImageScreenClick(ImageStepModel item)
